{
  "$defs": {
    "BoundsM": {
      "additionalProperties": false,
      "properties": {
        "x": {
          "exclusiveMinimum": 0,
          "title": "X",
          "type": "number"
        },
        "y": {
          "exclusiveMinimum": 0,
          "title": "Y",
          "type": "number"
        },
        "z": {
          "exclusiveMinimum": 0,
          "title": "Z",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y",
        "z"
      ],
      "title": "BoundsM",
      "type": "object"
    },
    "GeneratedAssetDatabaseCard": {
      "additionalProperties": false,
      "properties": {
        "asset_id": {
          "pattern": "^[a-z][a-z0-9_]{2,63}$",
          "title": "Asset Id",
          "type": "string"
        },
        "behavior_profile_candidates": {
          "items": {
            "pattern": "^[a-z][a-z0-9_]{2,63}$",
            "type": "string"
          },
          "maxItems": 12,
          "title": "Behavior Profile Candidates",
          "type": "array"
        },
        "behavior_profiles": {
          "items": {
            "pattern": "^[a-z][a-z0-9_]{2,63}$",
            "type": "string"
          },
          "maxItems": 12,
          "title": "Behavior Profiles",
          "type": "array"
        },
        "bounds_m": {
          "anyOf": [
            {
              "$ref": "#/$defs/BoundsM"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "capabilities": {
          "items": {
            "pattern": "^[a-z][a-z0-9_]{1,63}$",
            "type": "string"
          },
          "maxItems": 32,
          "title": "Capabilities",
          "type": "array"
        },
        "category": {
          "enum": [
            "adversary_role",
            "equipment",
            "effect",
            "training_marker",
            "threat_vector"
          ],
          "title": "Category",
          "type": "string"
        },
        "collision_profile": {
          "enum": [
            "none",
            "block_all",
            "overlap_only",
            "pawn"
          ],
          "title": "Collision Profile",
          "type": "string"
        },
        "constraints": {
          "items": {
            "pattern": "^[a-z][a-z0-9_]{1,63}$",
            "type": "string"
          },
          "maxItems": 32,
          "title": "Constraints",
          "type": "array"
        },
        "contract_type": {
          "const": "asset_card",
          "default": "asset_card",
          "title": "Contract Type",
          "type": "string"
        },
        "description": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "display_name": {
          "maxLength": 96,
          "minLength": 1,
          "title": "Display Name",
          "type": "string"
        },
        "equipment": {
          "items": {
            "pattern": "^[a-z][a-z0-9_]{1,63}$",
            "type": "string"
          },
          "maxItems": 24,
          "title": "Equipment",
          "type": "array"
        },
        "gameplay_tags": {
          "items": {
            "pattern": "^[a-z][a-z0-9_]{1,63}$",
            "type": "string"
          },
          "maxItems": 32,
          "minItems": 1,
          "title": "Gameplay Tags",
          "type": "array"
        },
        "ingestion_status": {
          "default": "prototype",
          "enum": [
            "ready",
            "prototype",
            "placeholder"
          ],
          "title": "Ingestion Status",
          "type": "string"
        },
        "likelihood_modifiers": {
          "patternProperties": {
            "^[a-z][a-z0-9_]{1,63}$": {
              "type": "number"
            }
          },
          "title": "Likelihood Modifiers",
          "type": "object"
        },
        "movement_domain": {
          "enum": [
            "ground",
            "air",
            "water",
            "interior"
          ],
          "title": "Movement Domain",
          "type": "string"
        },
        "preferred_affordances": {
          "items": {
            "pattern": "^[a-z][a-z0-9_]{1,63}$",
            "type": "string"
          },
          "maxItems": 32,
          "title": "Preferred Affordances",
          "type": "array"
        },
        "runtime_binding_hint": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Runtime Binding Hint",
          "type": "string"
        },
        "safety_note": {
          "const": "non-operational training simulation",
          "default": "non-operational training simulation",
          "title": "Safety Note",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source_rationale": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Source Rationale",
          "type": "string"
        },
        "spawn_affordances": {
          "items": {
            "pattern": "^[a-z][a-z0-9_]{1,63}$",
            "type": "string"
          },
          "maxItems": 32,
          "minItems": 1,
          "title": "Spawn Affordances",
          "type": "array"
        },
        "spawn_policy": {
          "enum": [
            "never_spawn",
            "scenario_director_whitelist"
          ],
          "title": "Spawn Policy",
          "type": "string"
        },
        "tactical_role": {
          "enum": [
            "recon",
            "harassment",
            "ambush",
            "patrol",
            "breach",
            "overwatch",
            "decoy"
          ],
          "title": "Tactical Role",
          "type": "string"
        },
        "threat_category": {
          "enum": [
            "dismounted_personnel",
            "uav",
            "fpv_drone",
            "quadcopter",
            "ugv",
            "vehicle",
            "usv",
            "weapon_equipment",
            "sensor_payload"
          ],
          "title": "Threat Category",
          "type": "string"
        },
        "threat_metadata": {
          "$ref": "#/$defs/ThreatMetadata"
        },
        "unreal_asset_path": {
          "anyOf": [
            {
              "pattern": "^/Game/.+",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Reviewed Unreal class, Blueprint, mesh, or data asset path.",
          "title": "Unreal Asset Path"
        },
        "visual_generation_prompt": {
          "maxLength": 1200,
          "minLength": 1,
          "title": "Visual Generation Prompt",
          "type": "string"
        }
      },
      "required": [
        "asset_id",
        "category",
        "display_name",
        "description",
        "spawn_policy",
        "gameplay_tags",
        "collision_profile",
        "threat_metadata",
        "threat_category",
        "movement_domain",
        "tactical_role",
        "visual_generation_prompt",
        "runtime_binding_hint",
        "spawn_affordances",
        "source_rationale"
      ],
      "title": "GeneratedAssetDatabaseCard",
      "type": "object"
    },
    "GeneratedTrellisCandidate": {
      "additionalProperties": false,
      "properties": {
        "allow_cached_demo_output": {
          "default": false,
          "title": "Allow Cached Demo Output",
          "type": "boolean"
        },
        "asset_category": {
          "enum": [
            "equipment",
            "threat_vector",
            "static_prop",
            "training_marker"
          ],
          "title": "Asset Category",
          "type": "string"
        },
        "asset_id": {
          "pattern": "^[a-z][a-z0-9_]{2,63}$",
          "title": "Asset Id",
          "type": "string"
        },
        "behavior_profile_candidates": {
          "items": {
            "pattern": "^[a-z][a-z0-9_]{2,63}$",
            "type": "string"
          },
          "maxItems": 12,
          "title": "Behavior Profile Candidates",
          "type": "array"
        },
        "cached_demo_key": {
          "default": "",
          "maxLength": 120,
          "title": "Cached Demo Key",
          "type": "string"
        },
        "detail_checklist": {
          "items": {
            "type": "string"
          },
          "maxItems": 24,
          "minItems": 1,
          "title": "Detail Checklist",
          "type": "array"
        },
        "display_name": {
          "maxLength": 96,
          "minLength": 1,
          "title": "Display Name",
          "type": "string"
        },
        "equipment": {
          "items": {
            "pattern": "^[a-z][a-z0-9_]{1,63}$",
            "type": "string"
          },
          "maxItems": 24,
          "title": "Equipment",
          "type": "array"
        },
        "generation_prompt": {
          "maxLength": 1600,
          "minLength": 1,
          "title": "Generation Prompt",
          "type": "string"
        },
        "geometry_descriptor": {
          "maxLength": 800,
          "minLength": 1,
          "title": "Geometry Descriptor",
          "type": "string"
        },
        "material_descriptor": {
          "maxLength": 800,
          "minLength": 1,
          "title": "Material Descriptor",
          "type": "string"
        },
        "movement_domain": {
          "enum": [
            "ground",
            "air",
            "water",
            "interior"
          ],
          "title": "Movement Domain",
          "type": "string"
        },
        "negative_prompt": {
          "maxLength": 800,
          "minLength": 1,
          "title": "Negative Prompt",
          "type": "string"
        },
        "resolution": {
          "default": "1024",
          "enum": [
            "512",
            "1024",
            "1536"
          ],
          "title": "Resolution",
          "type": "string"
        },
        "runtime_binding_hint": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Runtime Binding Hint",
          "type": "string"
        },
        "safety_note": {
          "const": "non-operational training simulation",
          "default": "non-operational training simulation",
          "title": "Safety Note",
          "type": "string"
        },
        "safety_notes": {
          "items": {
            "type": "string"
          },
          "maxItems": 24,
          "title": "Safety Notes",
          "type": "array"
        },
        "scale_descriptor": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Scale Descriptor",
          "type": "string"
        },
        "scene_context": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Scene Context",
          "type": "string"
        },
        "source_asset_id": {
          "pattern": "^[a-z][a-z0-9_]{2,63}$",
          "title": "Source Asset Id",
          "type": "string"
        },
        "spawn_affordances": {
          "items": {
            "pattern": "^[a-z][a-z0-9_]{1,63}$",
            "type": "string"
          },
          "maxItems": 32,
          "minItems": 1,
          "title": "Spawn Affordances",
          "type": "array"
        },
        "tactical_role": {
          "enum": [
            "recon",
            "harassment",
            "ambush",
            "patrol",
            "breach",
            "overwatch",
            "decoy"
          ],
          "title": "Tactical Role",
          "type": "string"
        },
        "target_format": {
          "const": "glb",
          "default": "glb",
          "title": "Target Format",
          "type": "string"
        },
        "texture_descriptor": {
          "maxLength": 800,
          "minLength": 1,
          "title": "Texture Descriptor",
          "type": "string"
        },
        "texture_size": {
          "default": 4096,
          "enum": [
            1024,
            2048,
            4096
          ],
          "title": "Texture Size",
          "type": "integer"
        },
        "threat_category": {
          "enum": [
            "dismounted_personnel",
            "uav",
            "fpv_drone",
            "quadcopter",
            "ugv",
            "vehicle",
            "usv",
            "weapon_equipment",
            "sensor_payload"
          ],
          "title": "Threat Category",
          "type": "string"
        },
        "threat_metadata": {
          "$ref": "#/$defs/ThreatMetadata"
        },
        "visual_descriptor": {
          "maxLength": 800,
          "minLength": 1,
          "title": "Visual Descriptor",
          "type": "string"
        },
        "visual_generation_prompt": {
          "maxLength": 1200,
          "minLength": 1,
          "title": "Visual Generation Prompt",
          "type": "string"
        }
      },
      "required": [
        "asset_id",
        "display_name",
        "threat_category",
        "movement_domain",
        "tactical_role",
        "visual_generation_prompt",
        "generation_prompt",
        "visual_descriptor",
        "geometry_descriptor",
        "material_descriptor",
        "texture_descriptor",
        "scale_descriptor",
        "scene_context",
        "detail_checklist",
        "negative_prompt",
        "source_asset_id",
        "runtime_binding_hint",
        "spawn_affordances",
        "asset_category",
        "threat_metadata"
      ],
      "title": "GeneratedTrellisCandidate",
      "type": "object"
    },
    "ThreatMetadata": {
      "additionalProperties": false,
      "properties": {
        "demo_priority": {
          "default": 0,
          "maximum": 10,
          "minimum": 0,
          "title": "Demo Priority",
          "type": "integer"
        },
        "platform_family": {
          "maxLength": 96,
          "minLength": 1,
          "title": "Platform Family",
          "type": "string"
        },
        "runtime_note": {
          "default": "Visual prototype only; runtime behavior, collision, scale, and spawn whitelist require Unreal review.",
          "maxLength": 240,
          "minLength": 1,
          "title": "Runtime Note",
          "type": "string"
        },
        "source_asset_id": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]{2,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Asset Id"
        },
        "source_database_path": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Database Path"
        },
        "source_rationale": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Rationale"
        },
        "threat_category": {
          "pattern": "^[a-z][a-z0-9_]{1,63}$",
          "title": "Threat Category",
          "type": "string"
        },
        "threat_domain": {
          "default": "unknown",
          "enum": [
            "air",
            "ground",
            "maritime",
            "equipment",
            "personnel",
            "unknown"
          ],
          "title": "Threat Domain",
          "type": "string"
        },
        "threat_id": {
          "pattern": "^[a-z][a-z0-9_]{2,63}$",
          "title": "Threat Id",
          "type": "string"
        },
        "training_role": {
          "maxLength": 180,
          "minLength": 1,
          "title": "Training Role",
          "type": "string"
        },
        "visual_fidelity_goal": {
          "maxLength": 240,
          "minLength": 1,
          "title": "Visual Fidelity Goal",
          "type": "string"
        }
      },
      "required": [
        "threat_id",
        "threat_category",
        "platform_family",
        "training_role",
        "visual_fidelity_goal"
      ],
      "title": "ThreatMetadata",
      "type": "object"
    }
  },
  "$id": "https://adaptsim.local/contracts/generated_asset_database.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "asset_cards": {
      "items": {
        "$ref": "#/$defs/GeneratedAssetDatabaseCard"
      },
      "maxItems": 16,
      "minItems": 1,
      "title": "Asset Cards",
      "type": "array"
    },
    "behavior_profiles": {
      "items": {
        "pattern": "^[a-z][a-z0-9_]{2,63}$",
        "type": "string"
      },
      "maxItems": 24,
      "title": "Behavior Profiles",
      "type": "array"
    },
    "cautions": {
      "items": {
        "type": "string"
      },
      "maxItems": 24,
      "title": "Cautions",
      "type": "array"
    },
    "contract_type": {
      "const": "generated_asset_database",
      "default": "generated_asset_database",
      "title": "Contract Type",
      "type": "string"
    },
    "input_evidence": {
      "items": {
        "type": "string"
      },
      "maxItems": 24,
      "title": "Input Evidence",
      "type": "array"
    },
    "scenario_seed_notes": {
      "items": {
        "type": "string"
      },
      "maxItems": 24,
      "title": "Scenario Seed Notes",
      "type": "array"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "session_summary": {
      "maxLength": 1000,
      "minLength": 1,
      "title": "Session Summary",
      "type": "string"
    },
    "trellis_candidates": {
      "items": {
        "$ref": "#/$defs/GeneratedTrellisCandidate"
      },
      "maxItems": 12,
      "title": "Trellis Candidates",
      "type": "array"
    }
  },
  "required": [
    "session_summary",
    "asset_cards"
  ],
  "title": "GeneratedAssetDatabase",
  "type": "object"
}
