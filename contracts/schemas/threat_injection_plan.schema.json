{
  "$defs": {
    "ThreatInjection": {
      "additionalProperties": false,
      "properties": {
        "action_summary": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Action Summary",
          "type": "string"
        },
        "entry_anchor_id": {
          "pattern": "^[a-z][a-z0-9_]{2,63}$",
          "title": "Entry Anchor Id",
          "type": "string"
        },
        "entry_anchor_tags": {
          "items": {
            "pattern": "^[a-z][a-z0-9_]{1,63}$",
            "type": "string"
          },
          "maxItems": 24,
          "minItems": 1,
          "title": "Entry Anchor Tags",
          "type": "array"
        },
        "generated_asset_display_name": {
          "maxLength": 96,
          "minLength": 1,
          "title": "Generated Asset Display Name",
          "type": "string"
        },
        "generated_asset_id": {
          "pattern": "^[a-z][a-z0-9_]{2,63}$",
          "title": "Generated Asset Id",
          "type": "string"
        },
        "injection_id": {
          "pattern": "^[a-z][a-z0-9_]{2,63}$",
          "title": "Injection Id",
          "type": "string"
        },
        "movement_domain": {
          "enum": [
            "ground",
            "air",
            "water",
            "interior"
          ],
          "title": "Movement Domain",
          "type": "string"
        },
        "plausibility_factors": {
          "items": {
            "type": "string"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Plausibility Factors",
          "type": "array"
        },
        "scenario_director_binding": {
          "items": {
            "type": "string"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Scenario Director Binding",
          "type": "array"
        },
        "scenario_event_id": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]{2,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scenario Event Id"
        },
        "success_criteria": {
          "items": {
            "type": "string"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Success Criteria",
          "type": "array"
        },
        "tactical_role": {
          "enum": [
            "recon",
            "harassment",
            "ambush",
            "patrol",
            "breach",
            "overwatch",
            "decoy"
          ],
          "title": "Tactical Role",
          "type": "string"
        },
        "threat_category": {
          "enum": [
            "dismounted_personnel",
            "uav",
            "fpv_drone",
            "quadcopter",
            "ugv",
            "vehicle",
            "usv",
            "weapon_equipment",
            "sensor_payload"
          ],
          "title": "Threat Category",
          "type": "string"
        },
        "trainee_objective": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Trainee Objective",
          "type": "string"
        },
        "trigger": {
          "$ref": "#/$defs/Trigger"
        }
      },
      "required": [
        "injection_id",
        "generated_asset_id",
        "generated_asset_display_name",
        "threat_category",
        "movement_domain",
        "tactical_role",
        "plausibility_factors",
        "entry_anchor_id",
        "entry_anchor_tags",
        "action_summary",
        "trainee_objective",
        "trigger",
        "success_criteria",
        "scenario_director_binding"
      ],
      "title": "ThreatInjection",
      "type": "object"
    },
    "Trigger": {
      "additionalProperties": false,
      "properties": {
        "anchor_id": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]{2,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Anchor Id"
        },
        "condition": {
          "anyOf": [
            {
              "maxLength": 300,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Condition"
        },
        "delay_s": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Delay S"
        },
        "trigger_type": {
          "enum": [
            "on_scenario_start",
            "trainee_enters_anchor",
            "timer_elapsed",
            "manual",
            "telemetry_condition"
          ],
          "title": "Trigger Type",
          "type": "string"
        }
      },
      "required": [
        "trigger_type"
      ],
      "title": "Trigger",
      "type": "object"
    }
  },
  "$id": "https://adaptsim.local/contracts/threat_injection_plan.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "assumptions": {
      "items": {
        "type": "string"
      },
      "maxItems": 12,
      "minItems": 1,
      "title": "Assumptions",
      "type": "array"
    },
    "contract_type": {
      "const": "threat_injection_plan",
      "default": "threat_injection_plan",
      "title": "Contract Type",
      "type": "string"
    },
    "environment_id": {
      "pattern": "^[a-z][a-z0-9_]{2,63}$",
      "title": "Environment Id",
      "type": "string"
    },
    "generated_asset_database_ref": {
      "maxLength": 260,
      "minLength": 1,
      "title": "Generated Asset Database Ref",
      "type": "string"
    },
    "generated_at": {
      "format": "date-time",
      "title": "Generated At",
      "type": "string"
    },
    "linked_scenario_manifest": {
      "anyOf": [
        {
          "maxLength": 260,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Linked Scenario Manifest"
    },
    "plan_id": {
      "pattern": "^[a-z][a-z0-9_]{2,63}$",
      "title": "Plan Id",
      "type": "string"
    },
    "planner_id": {
      "pattern": "^[a-z][a-z0-9_]{2,63}$",
      "title": "Planner Id",
      "type": "string"
    },
    "scenario_director_constraints": {
      "items": {
        "type": "string"
      },
      "maxItems": 12,
      "minItems": 1,
      "title": "Scenario Director Constraints",
      "type": "array"
    },
    "scenario_id": {
      "pattern": "^[a-z][a-z0-9_]{2,63}$",
      "title": "Scenario Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "semantic_environment_ref": {
      "maxLength": 260,
      "minLength": 1,
      "title": "Semantic Environment Ref",
      "type": "string"
    },
    "success_criteria": {
      "items": {
        "type": "string"
      },
      "maxItems": 12,
      "minItems": 1,
      "title": "Success Criteria",
      "type": "array"
    },
    "threat_asset_database_ref": {
      "maxLength": 260,
      "minLength": 1,
      "title": "Threat Asset Database Ref",
      "type": "string"
    },
    "threats": {
      "items": {
        "$ref": "#/$defs/ThreatInjection"
      },
      "maxItems": 12,
      "minItems": 1,
      "title": "Threats",
      "type": "array"
    },
    "trainee_objective": {
      "maxLength": 700,
      "minLength": 1,
      "title": "Trainee Objective",
      "type": "string"
    },
    "vignette_summary": {
      "maxLength": 700,
      "minLength": 1,
      "title": "Vignette Summary",
      "type": "string"
    }
  },
  "required": [
    "plan_id",
    "scenario_id",
    "environment_id",
    "planner_id",
    "generated_at",
    "semantic_environment_ref",
    "threat_asset_database_ref",
    "generated_asset_database_ref",
    "scenario_director_constraints",
    "vignette_summary",
    "trainee_objective",
    "assumptions",
    "threats",
    "success_criteria"
  ],
  "title": "ThreatInjectionPlan",
  "type": "object"
}
