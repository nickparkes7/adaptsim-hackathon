{
  "$defs": {
    "ScenarioEvent": {
      "additionalProperties": false,
      "properties": {
        "asset_id": {
          "pattern": "^[a-z][a-z0-9_]{2,63}$",
          "title": "Asset Id",
          "type": "string"
        },
        "avoid_tags": {
          "items": {
            "pattern": "^[a-z][a-z0-9_]{1,63}$",
            "type": "string"
          },
          "maxItems": 24,
          "title": "Avoid Tags",
          "type": "array"
        },
        "behavior_profile": {
          "pattern": "^[a-z][a-z0-9_]{2,63}$",
          "title": "Behavior Profile",
          "type": "string"
        },
        "count": {
          "maximum": 16,
          "minimum": 1,
          "title": "Count",
          "type": "integer"
        },
        "event_id": {
          "pattern": "^[a-z][a-z0-9_]{2,63}$",
          "title": "Event Id",
          "type": "string"
        },
        "event_type": {
          "enum": [
            "adversary_contact",
            "static_prop_spawn",
            "environmental_effect",
            "objective_marker",
            "inject"
          ],
          "title": "Event Type",
          "type": "string"
        },
        "intent": {
          "pattern": "^[a-z][a-z0-9_]{1,63}$",
          "title": "Intent",
          "type": "string"
        },
        "likelihood": {
          "description": "Scenario likelihood under stated assumptions, not calibrated intelligence truth.",
          "maximum": 1,
          "minimum": 0,
          "title": "Likelihood",
          "type": "number"
        },
        "likelihood_basis": {
          "const": "scenario_likelihood_under_assumptions",
          "default": "scenario_likelihood_under_assumptions",
          "title": "Likelihood Basis",
          "type": "string"
        },
        "max_distance_to_trainee_m": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Distance To Trainee M"
        },
        "parameters": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Parameters",
          "type": "object"
        },
        "rationale": {
          "maxLength": 700,
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "required_tags": {
          "items": {
            "pattern": "^[a-z][a-z0-9_]{1,63}$",
            "type": "string"
          },
          "maxItems": 24,
          "minItems": 1,
          "title": "Required Tags",
          "type": "array"
        },
        "severity": {
          "maximum": 1,
          "minimum": 0,
          "title": "Severity",
          "type": "number"
        },
        "trigger": {
          "$ref": "#/$defs/Trigger"
        }
      },
      "required": [
        "event_id",
        "event_type",
        "asset_id",
        "count",
        "intent",
        "required_tags",
        "severity",
        "likelihood",
        "behavior_profile",
        "trigger",
        "rationale"
      ],
      "title": "ScenarioEvent",
      "type": "object"
    },
    "Trigger": {
      "additionalProperties": false,
      "properties": {
        "anchor_id": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]{2,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Anchor Id"
        },
        "condition": {
          "anyOf": [
            {
              "maxLength": 300,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Condition"
        },
        "delay_s": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Delay S"
        },
        "trigger_type": {
          "enum": [
            "on_scenario_start",
            "trainee_enters_anchor",
            "timer_elapsed",
            "manual",
            "telemetry_condition"
          ],
          "title": "Trigger Type",
          "type": "string"
        }
      },
      "required": [
        "trigger_type"
      ],
      "title": "Trigger",
      "type": "object"
    }
  },
  "$id": "https://adaptsim.local/contracts/scenario_manifest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "assumptions": {
      "items": {
        "type": "string"
      },
      "maxItems": 12,
      "minItems": 1,
      "title": "Assumptions",
      "type": "array"
    },
    "contract_type": {
      "const": "scenario_manifest",
      "default": "scenario_manifest",
      "title": "Contract Type",
      "type": "string"
    },
    "display_name": {
      "maxLength": 120,
      "minLength": 1,
      "title": "Display Name",
      "type": "string"
    },
    "environment_id": {
      "pattern": "^[a-z][a-z0-9_]{2,63}$",
      "title": "Environment Id",
      "type": "string"
    },
    "events": {
      "items": {
        "$ref": "#/$defs/ScenarioEvent"
      },
      "maxItems": 24,
      "minItems": 1,
      "title": "Events",
      "type": "array"
    },
    "generated_at": {
      "format": "date-time",
      "title": "Generated At",
      "type": "string"
    },
    "likelihood_semantics": {
      "const": "scenario_likelihood_under_assumptions_not_calibrated_intelligence_truth",
      "default": "scenario_likelihood_under_assumptions_not_calibrated_intelligence_truth",
      "title": "Likelihood Semantics",
      "type": "string"
    },
    "planner_id": {
      "pattern": "^[a-z][a-z0-9_]{2,63}$",
      "title": "Planner Id",
      "type": "string"
    },
    "required_asset_ids": {
      "items": {
        "pattern": "^[a-z][a-z0-9_]{2,63}$",
        "type": "string"
      },
      "maxItems": 32,
      "minItems": 1,
      "title": "Required Asset Ids",
      "type": "array"
    },
    "scenario_id": {
      "pattern": "^[a-z][a-z0-9_]{2,63}$",
      "title": "Scenario Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "training_objective": {
      "maxLength": 700,
      "minLength": 1,
      "title": "Training Objective",
      "type": "string"
    }
  },
  "required": [
    "scenario_id",
    "environment_id",
    "display_name",
    "planner_id",
    "generated_at",
    "training_objective",
    "assumptions",
    "required_asset_ids",
    "events"
  ],
  "title": "ScenarioManifest",
  "type": "object"
}
