{
  "$defs": {
    "AssetGenerationSource": {
      "additionalProperties": false,
      "properties": {
        "reconstruction_manifest_uri": {
          "anyOf": [
            {
              "pattern": "^gs://[A-Za-z0-9._-]+/.+",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reconstruction Manifest Uri"
        },
        "semantic_environment_uri": {
          "anyOf": [
            {
              "pattern": "^gs://[A-Za-z0-9._-]+/.+",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Semantic Environment Uri"
        },
        "unreal_import_report_uri": {
          "anyOf": [
            {
              "pattern": "^gs://[A-Za-z0-9._-]+/.+",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unreal Import Report Uri"
        }
      },
      "title": "AssetGenerationSource",
      "type": "object"
    }
  },
  "$id": "https://adaptsim.local/contracts/asset_generation_request.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "capture_id": {
      "pattern": "^[a-z][a-z0-9_]{2,63}$",
      "title": "Capture Id",
      "type": "string"
    },
    "contract_type": {
      "const": "asset_generation_request",
      "default": "asset_generation_request",
      "title": "Contract Type",
      "type": "string"
    },
    "notes": {
      "anyOf": [
        {
          "maxLength": 500,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Notes"
    },
    "outputs_requested": {
      "items": {
        "enum": [
          "semantic_environment",
          "asset_card",
          "scenario_manifest"
        ],
        "type": "string"
      },
      "maxItems": 8,
      "minItems": 1,
      "title": "Outputs Requested",
      "type": "array"
    },
    "request_id": {
      "pattern": "^[a-z][a-z0-9_]{2,63}$",
      "title": "Request Id",
      "type": "string"
    },
    "requested_at": {
      "format": "date-time",
      "title": "Requested At",
      "type": "string"
    },
    "requester_id": {
      "pattern": "^[a-z][a-z0-9_]{2,63}$",
      "title": "Requester Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source": {
      "$ref": "#/$defs/AssetGenerationSource"
    }
  },
  "required": [
    "request_id",
    "capture_id",
    "requested_at",
    "requester_id",
    "source",
    "outputs_requested"
  ],
  "title": "AssetGenerationRequest",
  "type": "object"
}
